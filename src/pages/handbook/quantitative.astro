<style>
  .hero {
    background: linear-gradient(135deg, #8b0000 0%, #a52a2a 50%, #b22222 100%);
    color: white;
    padding: 4rem 0;
    margin: -2rem -2rem 3rem -2rem;
    border-radius: 0 0 30px 30px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(139, 0, 0, 0.2) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(165, 42, 42, 0.15) 0%, transparent 50%);
